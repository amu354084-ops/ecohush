# Optional local backup settings
ERP_AUTH_SECRET=replace-with-a-random-64-character-secret
ERP_INITIAL_ADMIN_PASSWORD=choose-a-strong-initial-password
ERP_CORS_ORIGINS=http://localhost:1833,http://127.0.0.1:1833
BACKUP_DIR=./backups
BACKUP_HOUR=23
BACKUP_MINUTE=00
BACKUP_TIMEZONE=UTC

# Optional Telegram delivery. Local backup works without these values.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
